# --- Přihlášení Google účtem (Auth.js) ---
# Vygenerujte příkazem: npx auth secret
AUTH_SECRET=

# Z Google Cloud Console → APIs & Services → Credentials → OAuth client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Kdo se smí přihlásit. Doména firmy, např. neresen.cz
# Necháte-li prázdné, musí být vyplněný POVOLENE_EMAILY.
POVOLENA_DOMENA=

# Volitelně konkrétní e-maily navíc, oddělené čárkou
POVOLENE_EMAILY=

# --- Google Sheets ---
# ID tabulky z URL: docs.google.com/spreadsheets/d/<TOHLE_JE_ID>/edit
SHEET_ID=

# Servisní účet: e-mail a privátní klíč z JSON souboru.
# Privátní klíč vložte celý včetně -----BEGIN PRIVATE KEY----- v uvozovkách.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""
